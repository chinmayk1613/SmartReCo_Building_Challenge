APP_NAME=SmartReco
APP_ENV=development
APP_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite:///./.smartreco/smartreco.db
QDRANT_PATH=./.smartreco/qdrant
# Leave QDRANT_URL empty to use the local QDRANT_PATH directory.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=smartreco-products

# Mandatory for submitted AI functionality. Never expose this in browser code.
MESH_API_KEY=
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_FREE_MODEL=minimax/m2-her
MESH_PAID_MODEL=openai/gpt-4o-mini
MESH_PREMIUM_MODEL=openai/gpt-5.4-mini
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small
# Development/tests may use the explicitly DEGRADED local hash fallback. Production requires true.
MESH_EMBEDDINGS_ENABLED=false
MESH_MODEL_MODE=free
# Ordered automatic failover: two free models, then a low-cost paid model.
MESH_FAILOVER_MODELS=minimax/m2-her,tencent/hy3,openai/gpt-4o-mini
MESH_TIMEOUT_SECONDS=90
MESH_CONTEXTUAL_TIMEOUT_SECONDS=25
MESH_SDK_MAX_RETRIES=1

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smartreco
LANGSMITH_RECONCILIATION_SECONDS=30
LANGSMITH_EXPORT_DELAY_SECONDS=120
LANGSMITH_RECONCILIATION_DAYS=7
# Raw graph inputs/outputs are hidden by the application; operational metadata remains traceable.

RECOMMENDATION_MIN_TRIGGER_SCORE=8
RECOMMENDATION_COOLDOWN_SECONDS=20
CONTEXTUAL_RECOMMENDATION_TTL_HOURS=24
SIGNAL_DEBOUNCE_SECONDS=5
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
REGISTRATION_EMAIL_DOMAIN=smartreco.ai
ALLOWED_HOSTS=127.0.0.1,localhost
COOKIE_SECURE=false
SCHEDULER_ENABLED=true

# Optional demo bootstrap. Set a strong password locally.
DEMO_ADMIN_EMAIL=admin@smartreco.local
DEMO_ADMIN_PASSWORD=

# Optional SMTP sandbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=SmartReco <recommendations@smartreco.local>
DELIVERY_MODE=sandbox
DELIVERY_MAX_ATTEMPTS=4
DELIVERY_RETRY_BASE_SECONDS=60
DELIVERY_OVERDUE_HOURS=24
DIGEST_HOUR_LOCAL=15
APP_PUBLIC_URL=http://127.0.0.1:8000

# UTC retention enforcement (aggregate interest profiles remain until an explicit user reset policy is adopted).
ACTIVITY_RETENTION_DAYS=180
SIGNAL_RETENTION_DAYS=30
RECOMMENDATION_RETENTION_DAYS=90
AUTH_ATTEMPT_RETENTION_DAYS=30

# Identity-bearing behavior tools are safe only over trusted local stdio until principal auth is added.
MCP_TRUSTED_LOCAL_ONLY=true
